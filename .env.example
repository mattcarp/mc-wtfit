# ─── Required ────────────────────────────────────────────────────────────────
# Public URL of the app (used in email links)
APP_URL=http://localhost:3000
# Database password for the bundled Postgres
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64. Encrypts profiles, API keys and photos. Generate: openssl rand -base64 32
# Lose this and the encrypted data is gone for good. Back it up somewhere safe.
ENCRYPTION_KEY=

# ─── Sign-in ─────────────────────────────────────────────────────────────────
# Option A (public server): Clerk. Create an application at dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Option B (just you, on your own machine): no sign-in, one owner account
# AUTH_MODE=local

# ─── Email (waitlist confirmations) ──────────────────────────────────────────
# Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=WTFIT <hello@example.com>
# Origins allowed to POST to /api/waitlist (e.g. a separately hosted landing page)
ALLOWED_ORIGINS=

# ─── Shared AI model (optional) ──────────────────────────────────────────────
# If set, users without their own key get a few free verdicts a day on this model.
# Providers: anthropic | openai | google | openai-compatible
SERVER_AI_PROVIDER=
SERVER_AI_KEY=
SERVER_AI_MODEL=
# For openai-compatible (Ollama: http://host:11434/v1)
SERVER_AI_BASE_URL=
SERVER_AI_DAILY_LIMIT=10

# ─── Default beneficiary (forks: point this at your own cause) ────────────────
# WTF This never handles money. After a sale it shows these details so the seller can send the proceeds.
DEFAULT_BENEFICIARY_NAME=Gozo SPCA
DEFAULT_BENEFICIARY_URL=https://gozo-spca.org/
DEFAULT_BENEFICIARY_IBAN=
DEFAULT_BENEFICIARY_BIC=
DEFAULT_BENEFICIARY_REVOLUT=
DEFAULT_BENEFICIARY_WISE=
DEFAULT_BENEFICIARY_NOTE=

# ─── Optional ────────────────────────────────────────────────────────────────
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
GITHUB_TOKEN=
PRIVACY_CONTACT=
HOSTING_DESCRIPTION=
